{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotmock.com/schemas/dotmock-project.schema.json",
  "title": "DotMock local project (dotmock.yaml)",
  "description": "Read by `dotmock serve` and dotmock-server local mode (`dotmock-server --local --config <file>` or DOTMOCK_LOCAL_MODE=true + DOTMOCK_LOCAL_CONFIG). YAML or JSON. Also accepted: a single API at the top level, or a single `dotmock config pull` (schemaVersion: dotmock/v2) definition. Fixture/settings shapes match dotmock-server pkg/llm/types.go.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/include"
          },
          {
            "$ref": "#/$defs/api"
          }
        ]
      }
    },
    "defaults": {
      "type": "object"
    }
  },
  "$defs": {
    "api": {
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "Selects this API via `X-Dotmock-Api`, a `/<subdomain>/` path prefix, or `<subdomain>.localhost`; the only API when just one is defined. Defaults to slug(name)."
        },
        "type": {
          "enum": [
            "llm",
            "openapi",
            "rest"
          ],
          "description": "Inferred from `fixtures` (llm) or `spec` (openapi) when omitted."
        },
        "defaultModel": {
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/llmSettings"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          }
        },
        "spec": {
          "description": "OpenAPI document inline, or a path relative to the project file.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "state": {
          "type": "array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "openapi",
                  "rest"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "spec"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "subdomain"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "llmSettings": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "chaos": {
          "$ref": "#/$defs/chaos"
        },
        "fallback": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "proxy",
                "record",
                "replay",
                "none"
              ]
            },
            "provider": {
              "type": "string"
            },
            "upstream": {
              "type": "string"
            }
          }
        },
        "vcrUpstreams": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metricsEnabled": {
          "type": "boolean"
        }
      }
    },
    "chaos": {
      "type": "object",
      "properties": {
        "dropRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "malformedRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disconnectRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rateLimitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disconnectAfterChunks": {
          "type": "integer",
          "minimum": 0
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fixture": {
      "type": "object",
      "description": "Defaults (server loader): id = slug(name) or fixture-<n>, name = id, priority = list index, enabled = true, protocol = both, match = {}.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "protocol": {
          "enum": [
            "http",
            "ws",
            "both"
          ]
        },
        "match": {
          "type": "object"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "workflow": {
          "type": "object",
          "properties": {
            "run": {
              "type": "object",
              "properties": {
                "toolCalls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/toolCall"
                  }
                }
              }
            },
            "response": {
              "$ref": "#/$defs/response"
            }
          }
        },
        "streaming": {
          "type": "object"
        },
        "latency": {
          "type": "object"
        },
        "ws": {
          "type": "object"
        },
        "chaos": {
          "$ref": "#/$defs/chaos"
        },
        "stateActions": {
          "type": "object"
        }
      },
      "anyOf": [
        {
          "required": [
            "response"
          ]
        },
        {
          "required": [
            "workflow"
          ]
        },
        {
          "required": [
            "ws"
          ]
        }
      ]
    },
    "toolCall": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "description": "JSON string, or a YAML/JSON object that is encoded for you.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "result": {
          "description": "Mocked tool return value; string or object.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "content": {
          "description": "String, or an object/array that is JSON-encoded (structured output).",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        },
        "reasoning": {
          "type": "string"
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "finishReason": {
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "content_filter"
          ]
        },
        "usage": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          }
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "include": {
      "type": "object",
      "required": [
        "file"
      ],
      "description": "Include another file (e.g. `dotmock config pull` output); sibling keys override it.",
      "properties": {
        "file": {
          "type": "string"
        }
      }
    }
  }
}
