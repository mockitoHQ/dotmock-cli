{
  "name": "@dotmock/cli",
  "version": "0.3.1",
  "description": "CLI for DotMock — create, manage, and use mock APIs",
  "keywords": [
    "dotmock",
    "api-mocking",
    "cli",
    "testing",
    "llm",
    "openai",
    "anthropic",
    "vitest"
  ],
  "homepage": "https://dotmock.com/docs/guides/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mockitoHQ/dotmock-cli.git"
  },
  "bugs": {
    "url": "https://dotmock.com/contact"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "dotmock": "dist/index.js"
  },
  "exports": {
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run type-check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
